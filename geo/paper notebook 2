    "\n",
    "def seasonal_decompose(x: np.ndarray, P: int) -> tuple[np.ndarray, np.ndarray]:\n",
    "    t     = np.arange(len(x))\n",
    "    theta = 2 * np.pi * t / P\n",
    "    C     = np.stack([np.cos(theta), np.sin(theta)], axis=1)\n",
    "    a, b  = np.linalg.lstsq(C, x, rcond=None)[0]\n",
    "    s     = a*C[:,0] + b*C[:,1]\n",
