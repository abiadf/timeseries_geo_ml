    "        self.device = device\n",
    "        # Learnable pseudo-inputs (u_k)\n",
    "        self.pseudo_inputs = nn.Parameter(torch.randn(K, window_size, input_dim))\n",
    "        self.idle_input = torch.eye(K, K).to(device) # For indexing\n",
